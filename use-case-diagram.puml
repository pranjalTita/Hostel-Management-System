@startuml use-case-diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #444444
skinparam usecase {
  BackgroundColor #E8F1FB
  BorderColor #2F6DB5
}

actor "Student" as Student
actor "Warden" as Warden
actor "Authentication Service /\nValidator" as Auth
actor "Notification & Record\nModules" as NotifyModule

rectangle "Hostel Management System" {

  ' ---- Student ----
  usecase "Login" as UC_Login
  usecase "Validate login" as UC_Validate
  usecase "Check room availability" as UC_CheckRoom
  usecase "Book room" as UC_BookRoom
  usecase "Pay fees" as UC_PayFees
  usecase "Get fee receipt" as UC_FeeReceipt
  usecase "Apply for leave" as UC_ApplyLeave
  usecase "View attendance" as UC_ViewAtt
  usecase "Register visitor" as UC_RegVisitor

  ' ---- Warden ----
  usecase "Approve leave" as UC_ApproveLeave
  usecase "Notify student" as UC_Notify
  usecase "Allocate room" as UC_AllocateRoom
  usecase "Mark attendance" as UC_MarkAtt
  usecase "Manage visitor\nentry / exit" as UC_VisitorLog
  usecase "Manage students" as UC_ManageStudents
  usecase "Generate reports" as UC_GenerateReports

  ' Student use cases
  Student -right-> UC_Login
  Student -right-> UC_CheckRoom
  Student -right-> UC_BookRoom
  Student -right-> UC_PayFees
  Student -right-> UC_ApplyLeave
  Student -right-> UC_ViewAtt
  Student -right-> UC_RegVisitor

  ' Warden use cases
  Warden -right-> UC_ApproveLeave
  Warden -right-> UC_AllocateRoom
  Warden -right-> UC_MarkAtt
  Warden -right-> UC_VisitorLog
  Warden -right-> UC_ManageStudents
  Warden -right-> UC_GenerateReports

  ' Include relationships
  UC_Login .down.> UC_Validate : <<include>>
  UC_PayFees .down.> UC_FeeReceipt : <<include>>
  UC_BookRoom .down.> UC_CheckRoom : <<include>>
  UC_ApproveLeave .down.> UC_Notify : <<include>>
}

' System actor interactions
UC_Validate .right. Auth
UC_Notify .right. NotifyModule

@enduml
